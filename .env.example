# Host connection. Inside docker compose the app overrides the host with "db".
DATABASE_URL=postgresql://condo:condo@localhost:5432/condo?schema=public

# Public URL of the app. Required: inside a container the request host is the
# bind address (0.0.0.0), which Google rejects as a redirect target.
AUTH_URL=http://localhost:3000

# openssl rand -base64 33
AUTH_SECRET=

# Google Cloud Console > Credentials > OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Integration tests wipe tables; they must never point at the dev database.
DATABASE_URL_TEST=postgresql://condo:condo@localhost:5432/condo_test?schema=public
